{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "unified-shell": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "inlineTemplate": true,
          "inlineStyle": true
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "ssr": false,
            "prerender": false,
            "preserveSymlinks": false,
            "assets": [
              { "glob": "**/*", "input": "public" },
              { "glob": "**/*", "input": "../new-portfolio/public", "output": "/" },
              { "glob": "**/*", "input": "../portfolio-angular/public", "output": "/" },
              { "glob": "p1.png", "input": "../portfolio-angular/src/assets", "output": "/assets" },
              { "glob": "styles.css", "input": "../new-portfolio/src", "output": "/assets/os" },
              { "glob": "styles.css", "input": "../portfolio-angular/src", "output": "/assets/classic" }
            ],
            "styles": [
              "src/styles.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2MB",
                  "maximumError": "4MB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "unified-shell:build:production"
            },
            "development": {
              "buildTarget": "unified-shell:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
